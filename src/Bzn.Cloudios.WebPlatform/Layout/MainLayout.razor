@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@using Bzn.Cloudios.WebPlatform.Auth

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            <div class="page dark-mode">
                <div class="sidebar">
                    <div class="sidebar-header">
                        <h3>Cloudios Admin</h3>
                    </div>
                    <NavMenu />
                </div>

                <main>
                    <div class="top-row px-4">
                        <div class="user-info">
                            <span class="user-name">@context.User.Identity?.Name</span>
                            <span class="admin-badge">Global Admin</span>
                        </div>
                        <button class="logout-btn" @onclick="Logout">Logout</button>
                    </div>

                    <article class="content px-4">
                        @Body
                    </article>
                </main>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="unauthorized dark-mode">
                <h2>Access Denied</h2>
                <p>This platform is restricted to Global Administrators only.</p>
                <button @onclick="NavigateToLogin">Go to Login</button>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    private async Task Logout()
    {
        if (AuthStateProvider is CustomAuthStateProvider customAuth)
        {
            await customAuth.MarkUserAsLoggedOut();
        }
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private void NavigateToLogin()
    {
        Navigation.NavigateTo("/login");
    }
}
