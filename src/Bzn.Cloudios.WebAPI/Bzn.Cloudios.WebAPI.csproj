    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bzn.Cloudios.Application\Bzn.Cloudios.Application.csproj" />
    <ProjectReference Include="..\Bzn.Cloudios.Infrastructure\Bzn.Cloudios.Infrastructure.csproj" />
  </ItemGroup>

</Project>
