@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@using Bzn.Cloudios.WebApp.Auth

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            <div class="page">
                <div class="sidebar">
                    <div class="sidebar-header">
                        <h3>Cloudios</h3>
                    </div>
                    <NavMenu />
                </div>

                <main>
                    <div class="top-row px-4">
                        <div class="user-info">
                            <span class="user-name">@context.User.Identity?.Name</span>
                            <span class="realm-name">@context.User.FindFirst("RealmId")?.Value</span>
                        </div>
                        <button class="logout-btn" @onclick="Logout">Logout</button>
                    </div>

                    <article class="content px-4">
                        @Body
                    </article>
                </main>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="unauthorized">
                <h2>Please log in to access this page</h2>
                <button @onclick="NavigateToLogin">Go to Login</button>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    private async Task Logout()
    {
        if (AuthStateProvider is CustomAuthStateProvider customAuth)
        {
            await customAuth.MarkUserAsLoggedOut();
        }
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private void NavigateToLogin()
    {
        Navigation.NavigateTo("/login");
    }
}
